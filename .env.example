# Copy this file to .env and fill in values
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: destination email address used by your own wrappers/scripts
NEWSLETTER_TO_EMAIL=

# Newsletter handoff. Leave AUTO_SEND unset to stop for human review.
# AUTO_SEND=1
# REVIEW_DASHBOARD=1
# REVIEW_PORT=8765
# PROMPT_REVIEW=1
# MODEL_AUDIT=1
# SLACK_FEEDBACK_WEBHOOK=
